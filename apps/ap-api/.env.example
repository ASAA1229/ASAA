# Example API settings. Copy to .env (git-ignored) and adjust. Placeholders only: never put real secrets in this file.

# --- Local single sign-on (Keycloak realm "asaa", loopback only) ---------------------------------------------------
# The API only verifies RS256 tokens; it never issues them. Plain http is accepted ONLY for localhost / 127.0.0.1.
# ASAA_AP_JWT_JWKS_URL=http://127.0.0.1:8280/realms/asaa/protocol/openid-connect/certs
# ASAA_AP_JWT_ISSUER=http://127.0.0.1:8280/realms/asaa
# ASAA_AP_JWT_AUDIENCE=asaa-api
# Optional MFA assurance enforcement (values depend on the identity provider configuration):
# ASAA_AP_REQUIRED_ACR=
# ASAA_AP_REQUIRED_AMR=

# --- Database ------------------------------------------------------------------------------------------------------
# Default is SQLite for development. Production requires PostgreSQL.
# ASAA_AP_DATABASE_URL=sqlite:///./asaa_ap.db

# --- Ecosystem integration -----------------------------------------------------------------------------------------
# Sibling services are contacted only on loopback unless their host is listed (JSON list).
# ASAA_AP_ECOSYSTEM_ALLOWED_HOSTS=[]
# Override a sibling base URL: ASAA_AP_ECOSYSTEM_<SERVICE>_URL (service id upper-cased, dashes as underscores).
# ASAA_AP_ECOSYSTEM_TEMPLATES_API_URL=http://127.0.0.1:4000
# ASAA_AP_ECOSYSTEM_REGISTRY_PATH=
# ASAA_AP_BUILD_COMMIT=
