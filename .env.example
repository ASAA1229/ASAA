# Example portal (Vite) settings. Copy to .env.local (git-ignored) and adjust. Placeholders only: never put secrets here.

# API the portal talks to (dev API default is 8001; local-prod is 8101).
# VITE_API_BASE_URL=http://127.0.0.1:8001

# --- Local single sign-on (Keycloak realm "asaa", loopback only) ---------------------------------------------------
# Authorization code + PKCE with a public client. Plain http is accepted ONLY for localhost / 127.0.0.1
# (src/identity/urlPolicy.js); any other identity endpoint must use https.
# VITE_OIDC_AUTHORITY=http://127.0.0.1:8280/realms/asaa
# VITE_OIDC_CLIENT_ID=asaa-portal
# VITE_OIDC_REDIRECT_URI=http://127.0.0.1:5173
# VITE_OIDC_SCOPES=openid profile email
