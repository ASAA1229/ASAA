    "lint": "eslint .",
    "audit:high": "npm audit --audit-level=high",
    "test:ui": "vitest run",
    "test": "npm run test:web && npm run test:ui"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
